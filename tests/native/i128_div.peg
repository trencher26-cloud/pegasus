// 128-bit division and remainder (spec/native.md §3): the native backend
// divides i128/u128 in its own IR helper (no compiler-rt call such as
// __divti3, which MSVC's runtime lacks). Divisors above 2^127 exercise the
// helper's carry path; signed cases cover truncation and MIN.
fn ud(a: u128, b: u128) -> u128 = a / b
fn ur(a: u128, b: u128) -> u128 = a % b
fn sd(a: i128, b: i128) -> i128 = a / b
fn sr(a: i128, b: i128) -> i128 = a % b

