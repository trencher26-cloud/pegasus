fn first(items: Span<i32>) -> i32 { items[0] }
fn head(items: Span<i32>) -> in i32 { items[0] }
impl Parser { fn rest(self) -> str { self.src[self.pos..] } }
fn longer(a: str, b: str) -> str { if a.len >= b.len { a } else { b } }
